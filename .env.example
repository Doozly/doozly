# Copy to .env.local and fill in. .env.local is gitignored.

# OAuth client ID (type "Web application") from the Google Cloud project.
# Not a secret, but it lives here so forks can use their own.
VITE_GOOGLE_CLIENT_ID=

# Application (client) ID of the Microsoft Entra app registration (SPA platform).
VITE_MICROSOFT_CLIENT_ID=

# App key of the Dropbox app (scoped access, "App folder"). Redirect URIs to add in
# its settings: <origin>/redirect.html for each web origin, and for the desktop app
# http://localhost:38471, http://localhost:38472 and http://localhost:38473.
VITE_DROPBOX_CLIENT_ID=

# The relay (relay/), e.g. http://localhost:8080 locally. With it Google and Dropbox
# sign-ins last instead of running out after an hour (Dropbox: 4 hours). Leave empty to run without.
VITE_RELAY_URL=
