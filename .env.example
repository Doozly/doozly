# Copy to .env.local and fill in. .env.local is gitignored.

# OAuth client ID (type "Web application") from the Google Cloud project.
# Not a secret, but it lives here so forks can use their own.
VITE_GOOGLE_CLIENT_ID=

# Application (client) ID of the Microsoft Entra app registration (SPA platform).
VITE_MICROSOFT_CLIENT_ID=

# The relay (relay/), e.g. http://localhost:8080 locally. With it Google sign-ins
# last instead of running out after an hour. Leave empty to run without.
VITE_RELAY_URL=
