{
  "name": "doozly",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "size": "node scripts/bundle-size.ts",
    "typecheck": "tsc -b",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "relay": "cd relay && go run . -env relay.env",
    "relay:test": "cd relay && go vet ./... && go test ./...",
    "relay:deploy": "sh relay/deploy/deploy.sh",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:test": "cd src-tauri && cargo clippy --all-targets -- -D warnings && cargo test",
    "desktop:e2e": "tauri build --debug --no-bundle && node --test --test-timeout=120000 'e2e-desktop/*.test.ts'",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "sh scripts/pre-commit.sh"
  },
  "dependencies": {
    "@azure/msal-browser": "5.30.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@internationalized/date": "3.12.4",
    "@phosphor-icons/core": "^2.1.1",
    "@tauri-apps/api": "2.12.5",
    "fractional-indexing": "^4.0.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "^8.1.2",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "4.10.2",
    "jsdom": "^31.0.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.1.1",
    "workbox-build": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
