# The server's settings. Copy to /etc/doozly-relay/relay.env (root, mode 0600). Never commit the real one.

# 32+ random bytes, base64: openssl rand -base64 32. Changing it signs everyone out of the relay.
RELAY_SESSION_KEY=

RELAY_ADDR=127.0.0.1:8080
RELAY_DB=/var/lib/doozly-relay/relay.db
RELAY_ALLOWED_ORIGINS=https://doozly.app
RELAY_TRUSTED_PROXIES=127.0.0.1/32,::1/128
RELAY_SESSION_TTL=720h
RELAY_LOG_LEVEL=info

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=

# doozly-relay -vapid-keys. Changing the pair cuts off every browser's push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
