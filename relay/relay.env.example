# Copy to relay.env for local runs (gitignored). On the server systemd reads the same keys.

# Required: 32+ random bytes, base64. Make one with: openssl rand -base64 32
RELAY_SESSION_KEY=

RELAY_ADDR=127.0.0.1:8080
RELAY_DB=relay.db
RELAY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Proxies whose CF-Connecting-IP header we believe. cloudflared runs on loopback.
RELAY_TRUSTED_PROXIES=127.0.0.1/32,::1/128
RELAY_SESSION_TTL=720h
RELAY_LOG_LEVEL=info

# A provider is only accepted when its client ID is set (the same IDs as the SPA's)
GOOGLE_CLIENT_ID=
# The OAuth client's secret from Google Cloud. Turns on the Google token endpoints
# (staying signed in with Google). Never put it in the SPA.
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=

# Web push for closed-app reminders. Make a pair with: go run . -vapid-keys
# Keep the private key secret. Changing the pair cuts off every browser's subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the push services can contact: mailto:you@example.com or an https URL
VAPID_SUBJECT=
